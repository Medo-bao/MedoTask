{
  "name": "medotask",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MedoTask — 多窗口、离线优先的桌面待办应用",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:clean": "vite build --mode clean",
    "preview": "vite preview",
